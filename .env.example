# Point at your local Ollama
OLLAMA_HOST=http://127.0.0.1:11434

# The default model for this computer (Apache-2.0). It runs on the local Ollama
# server and is what the app uses out of the box.
#   ollama pull gemma3:4b
BIOLEDGER_MODEL=gemma3:4b

# Optional mobile model: "Gemma 4 E2B (for mobile)" runs entirely in the browser
# (Transformers.js on WebGPU). It is a separate runtime, downloaded only when you
# select it in the app, and never a fallback for the desktop model. It needs no
# environment variable here.

BIOLEDGER_EMBED_MODEL=nomic-embed-text
BIOLEDGER_VISION_MODEL=gemma3:4b

# Uploaded observation photos are written here (generated filenames only) and
# served from /api/photos/<name>. 10 MB cap by default.
BIOLEDGER_PHOTO_DIR=./photos
BIOLEDGER_MAX_IMAGE_MB=10

# Default store is a local SQLite file (fully offline).
# To use Tiger Cloud / local TimescaleDB+pgvector instead, set DATABASE_URL. If
# Postgres cannot be reached at startup, the app falls back to SQLite.
# DATABASE_URL=postgres://tsdbadmin:password@host:port/tsdb?sslmode=require

# ---------------------------------------------------------------------------
# Production (single-origin or split front end). All of these are optional.
# See DEPLOYMENT.md for exact platform settings.
# ---------------------------------------------------------------------------

# Public origin (scheme://host, no trailing slash) that browsers use to reach
# this API. Leave empty when the UI and API share one origin or a reverse proxy
# (e.g. the Vercel rewrite) forwards /api on the same origin. When set, photo
# URLs are returned absolute so they work from another host.
# BIOLEDGER_PUBLIC_BASE=https://api.example.com

# Comma-separated allowlist of browser origins allowed to call the API directly
# from a different origin. Empty = send no CORS headers (safe default). Never
# use "*".
# BIOLEDGER_CORS_ORIGINS=https://app.example.com

# Outbound timeout for Ollama requests. Keep it small on a cloud box that has no
# Ollama so offline providers fail fast instead of hanging the request.
# BIOLEDGER_TIMEOUT=10

# Bind port for local start commands; Render injects its own PORT automatically.
# PORT=8000
